{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure ROS workspace",
      "type": "cmake",
      "command": "configure",
      "preset": "ros2-jazzy",
      "problemMatcher": [],
      "dependsOn": "Activate workspace preset"
    },
    {
      "label": "Build ROS workspace",
      "type": "cmake",
      "command": "build",
      "preset": "ros2-jazzy",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run RMUC simulation",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source scripts/env.sh; ros2 launch ego_gazebo sim.launch.py"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Activate workspace preset",
      "type": "shell",
      "command": "true",
      "args": [
        "${input:activatePreset}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run RMUC headless",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source scripts/env.sh; ros2 launch ego_gazebo sim.launch.py headless:=true rviz:=false"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "activatePreset",
      "type": "command",
      "command": "cmake.setConfigurePreset",
      "args": "ros2-jazzy"
    }
  ]
}
