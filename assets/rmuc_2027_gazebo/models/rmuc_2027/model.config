<?xml version="1.0"?>
<model>
  <name>rmuc_2027</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>RMUC 2027 field conversion</name>
    <email>none</email>
  </author>
  <description>
    RMUC 2027 competition field, 28 m x 16 m x 3.8 m, metres, Z-up.
    Visual: rm-map-tools simplified GLB (828k triangles, colours and Base artwork),
    with red/blue colours fixed per team, official base and outpost dart stickers,
    and the two outpost rotors moved to rmuc_2027_outpost_rotor_red / _blue.
    Collision: the same GLB geometry without the rotors, decimated part by part to
    135.9k triangles (98% of each part within 3 cm of the original surface).
  </description>
</model>
