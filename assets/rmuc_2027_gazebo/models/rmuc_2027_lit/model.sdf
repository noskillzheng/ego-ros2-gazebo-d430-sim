<?xml version="1.0"?>
<sdf version="1.10">
  <model name="rmuc_2027_lit">
    <static>true</static>
    <link name="field">
      <!-- Generated by tools/build_from_glb.py from the visual GLB, without the two outpost
           rotors (they are separate spinning models, rmuc_2027_outpost_rotor_red/_blue).
           Bitmask 0x01 keeps the rotor boxes (0x02) from touching the field; robots
           (default 0xffff) hit both. -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://rmuc_2027/meshes/rmuc_2027_collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
            <ode>
              <kp>1e8</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Venue-lighting copy of rmuc_2027 (tools/build_venue_lighting.py):
           measured floor/wall/paint reflectance, emissive light bars.
           rm-map-tools RMUC 2027 simplified GLB, colours and Base artwork embedded.
           No <material> here: an SDF material would override the GLB materials. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://rmuc_2027_lit/meshes/rmuc_2027_visual_lit.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
