<?xml version="1.0"?>
<!-- Generated by tools/build_from_glb.py. Place the model frame on the rotor axis
     (see tools/build_report.json); the rotor spins about +Z. -->
<sdf version="1.10">
  <model name="rmuc_2027_outpost_rotor_red">
    <link name="rotor">
      <gravity>false</gravity>
      <!-- Placeholder inertia (no measured mass in the CAD): 2 kg ring, r = 0.27 m. -->
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.073</ixx><iyy>0.073</iyy><izz>0.146</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><mesh><uri>model://rmuc_2027_outpost_rotor_red/meshes/rotor_visual.glb</uri></mesh></geometry>
      </visual>
      <collision name="armor_module_0">
        <pose>-0.267247 0 -0.130331 -1.570796 0.261793 -3.141593</pose>
        <geometry><box><size>0.017001 0.124932 0.140864</size></box></geometry>
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <collision name="armor_module_1">
        <pose>0.133648 -0.231485 0.073797 1.570805 0.26181 -1.047198</pose>
        <geometry><box><size>0.017001 0.124932 0.140864</size></box></geometry>
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <collision name="armor_module_2">
        <pose>0.133611 0.231421 -0.028749 1.570796 0.261767 1.047198</pose>
        <geometry><box><size>0.017003 0.124732 0.140864</size></box></geometry>
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
    </link>
    <joint name="rotor_joint" type="revolute">
      <parent>world</parent>
      <child>rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping><friction>0</friction></dynamics>
      </axis>
    </joint>
    <!-- Velocity mode. Change speed at runtime, e.g. stop:
         gz topic -t /model/<name>/joint/rotor_joint/cmd_vel -m gz.msgs.Double -p 'data: 0' -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_joint</joint_name>
      <initial_velocity>2.5132741228718345</initial_velocity>
    </plugin>
  </model>
</sdf>
