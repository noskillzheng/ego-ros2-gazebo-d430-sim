<?xml version="1.0"?>
<sdf version="1.10">
  <world name="rmuc_2027">
    <gravity>0 0 -9.81</gravity>

    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.25 0.27 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field occupies x 0..28.15, y 0..16.07.
         To center it at the world origin instead, use pose -14.07 -8.03 0 0 0 0. -->
    <include>
      <uri>model://rmuc_2027</uri>
      <name>rmuc_2027</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
