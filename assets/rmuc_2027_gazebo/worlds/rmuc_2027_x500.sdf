<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <world name="rmuc_2027">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.25 0.27 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://rmuc_2027</uri>
      <name>rmuc_2027</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- Flat launch pad above the uneven RMUC mesh, with no initial penetration. -->
    <model name="launch_pad">
      <static>true</static>
      <pose>2 2 0.35 0 0 0</pose>
      <link name="pad">
        <collision name="collision"><geometry><box><size>1.5 1.5 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.5 0.3</size></box></geometry>
          <material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.2 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://x500_d430</uri>
      <name>x500_d430_0</name>
      <pose>2 2 0.8 0 0 0</pose>
    </include>
  </world>
</sdf>
